# ─── Supabase ────────────────────────────────────────────────
# 1. Go to https://supabase.com → create a new project
# 2. Go to Project Settings → API
# 3. Copy the values below

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — bypasses RLS, used ONLY in server-side admin API
# routes (save/edit/delete components, upload thumbnails). Never expose
# this to the browser. Same Project Settings → API page as above.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Admin ───────────────────────────────────────────────────
# Simple password to protect the /library/admin extraction tool
# Change this to something secure before deploying
ADMIN_PASSWORD=rareui-admin-2024

# ─── Figma API (renders the real preview shown on Add Component) ───
# Personal access token, "File content" read scope is enough.
# Get one at figma.com → account settings → Personal access tokens.
# Without this, extraction still works but the preview panel and
# auto-thumbnail stay empty (manual Thumbnail URL still works as a fallback).
FIGMA_ACCESS_TOKEN=your-figma-token
